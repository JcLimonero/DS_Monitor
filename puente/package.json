{
  "name": "ds-monitor-puente",
  "version": "0.1.0",
  "description": "Puente de DS Monitor: guarda las credenciales, consulta o recibe los datos, y los traduce al modelo del portal",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "node --watch --experimental-strip-types src/index.ts",
    "test": "npm run build && node --test \"dist/**/*.prueba.js\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check:contrato": "tsc --noEmit -p tsconfig.contrato.json",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\""
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "prettier": "^3.2.2",
    "typescript": "~5.9.3"
  }
}
