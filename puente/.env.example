# Configuración del puente.
#
# Copiar a .env (que está en .gitignore) o cargar estas variables en el panel
# del servidor. AQUÍ VAN LAS CREDENCIALES: este archivo de ejemplo no lleva
# ninguna de verdad, y el .env real nunca se sube al repositorio.
#
# Nada es obligatorio. Una conexión sin credencial queda apagada, su ruta
# responde 503 diciendo qué falta, y el resto del puente sigue funcionando: así
# se puede conectar una fuente a la vez.

# --- Servidor ---
PUENTE_PUERTO=8787
# Prefijo bajo el que cuelga, si va detrás de un proxy. En producción el portal
# lo espera en /api/portal.
PUENTE_PREFIJO=
# Orígenes que pueden llamarlo, separados por coma. Vacío = solo mismo origen,
# que es lo recomendable: así la cookie de sesión viaja sola y no hace falta CORS.
PUENTE_ORIGENES=

# --- Cuánto vive cada respuesta en caché, en segundos ---
# Los datos de uso de Claude tardan hasta cinco minutos en aparecer y no
# conviene sondear más de una vez por minuto, así que cinco minutos es el piso
# razonable para licencias.
CACHE_LICENCIAS_SEGUNDOS=300
CACHE_DESPLIEGUES_SEGUNDOS=30
CACHE_ESTADO_SEGUNDOS=60
CACHE_MONITOREO_SEGUNDOS=60
CACHE_CRM_SEGUNDOS=120

# --- Claude (Anthropic) ---
# Admin API key de la organización, no una llave normal de API.
# Se crea en la consola: Settings -> Admin keys.
ANTHROPIC_ADMIN_KEY=
ANTHROPIC_ACCOUNT_ID=claude
# Los asientos de Claude Code no salen de la API de uso. Si se capturan aquí,
# el portal los muestra marcados como capturados a mano.
ANTHROPIC_ASIENTOS=
ANTHROPIC_COSTO_ASIENTOS=
ANTHROPIC_RENUEVA_EN=

# --- Cursor ---
# Team API key con permiso admin:* o usage:*.
CURSOR_API_KEY=
CURSOR_ACCOUNT_ID=cursor
CURSOR_ASIENTOS=
CURSOR_COSTO_MENSUAL=
CURSOR_SOLICITUDES_INCLUIDAS=
CURSOR_RENUEVA_EN=

# --- Figma ---
# OJO: Figma no publica facturación ni asientos contratados por API. Con el
# token se cuentan los asientos ocupados; el tope, el costo y la renovación se
# capturan abajo y la licencia sale marcada como capturada a mano.
FIGMA_TOKEN=
FIGMA_TEAM_ID=
FIGMA_ACCOUNT_ID=figma
FIGMA_ASIENTOS=
FIGMA_COSTO_MENSUAL=
FIGMA_RENUEVA_EN=

# --- Vercel ---
VERCEL_TOKEN=
VERCEL_ACCOUNT_ID=vercel
# Sale de la configuración general del equipo en el panel de Vercel.
VERCEL_TEAM_ID=
VERCEL_LIMITE=20
VERCEL_URL_ESTADO=https://www.vercel-status.com/api/v2/status.json
# El gasto del periodo no viene por API; si se captura aquí, sale como licencia.
VERCEL_PRESUPUESTO=
VERCEL_GASTO=
VERCEL_RENUEVA_EN=

# --- Monitoreo de sitios y servicios ---
# Formato: id|nombre|url|tipo|entorno ; separados por punto y coma.
# tipo: sitio | api | servicio | proceso
# entorno: produccion | pruebas | desarrollo
MONITOREO_ACCOUNT_ID=plataformas
MONITOREO_DESTINOS=

# --- Odoo (CRM de Itech) ---
ODOO_URL=
ODOO_DB=
ODOO_USUARIO=
# Clave de API del usuario, no su contraseña.
ODOO_API_KEY=
ODOO_ACCOUNT_ID=itech

# --- GitHub (ir por los datos) ---
# Token con lectura sobre los repositorios. En uno clásico, permiso "repo"; en
# uno de grano fino, contents:read + pull_requests:read + checks:read.
GITHUB_TOKEN=
GITHUB_ACCOUNT_ID=github
# Repositorios a vigilar, separados por coma, como "propietario/repositorio".
GITHUB_REPOS=
GITHUB_LIMITE_PR=10
CACHE_REPOS_SEGUNDOS=120

# --- Acceso al portal con código por correo ---
# Con estas cinco variables el puente exige entrar: quien escriba un correo de
# la lista recibe un código de seis dígitos por EmailJS (mismo servicio y
# plantilla de siempre; el correo lleva título "Access Monitor") y con él una
# sesión de 30 días. Sin ellas el puente queda abierto (útil en desarrollo).
# También se capturan desde Ajustes → Integraciones → Acceso al portal.
ACCESO_CORREOS=
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
# Account → Security en EmailJS. Sin ella EmailJS rechaza envíos desde servidor.
EMAILJS_PRIVATE_KEY=
# Dónde viven el equipo, los dominios y las sesiones (fuera del repo).
DATOS_DIRECTORIO=datos

# --- Edición de buzones desde Ajustes ---
# Con este token el portal puede guardar credenciales de buzones, probar la
# conexión y pasar por el consentimiento de Microsoft. Genera uno largo y al
# azar; sin él, esas rutas responden 503 y el resto del puente sigue igual.
PUENTE_ADMIN_TOKEN=
# URL con la que se llega al puente desde afuera; con ella se arma la URI de
# regreso de OAuth (<url>/correo/oauth/callback), que debe estar registrada
# en la aplicación de Entra ID. Por omisión http://localhost:<puerto><prefijo>.
PUENTE_URL_PUBLICA=
# Dónde se guardan las credenciales capturadas desde Ajustes (fuera del repo).
CORREO_DIRECTORIO=datos/correo
INTEGRACIONES_DIRECTORIO=datos/integraciones

# --- Aplicación de Entra ID para los buzones de Microsoft ---
# Una sola aplicación para todos los buzones de Microsoft: Id. de aplicación,
# secreto y tenant ("common" acepta cuentas de trabajo y personales). Permisos
# delegados Mail.Read, Calendars.Read, User.Read, offline_access; URI de
# redirección <PUENTE_URL_PUBLICA>/correo/oauth/callback. También se captura
# desde Ajustes → Integraciones → Microsoft. Cada buzón se conecta después con
# "Conectar con Microsoft" en Ajustes → Correo.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common

# --- Aplicación OAuth de Google para los buzones de Gmail ---
# Cliente OAuth "Aplicación web" en Google Cloud (APIs y servicios →
# Credenciales), con URI de redirección <PUENTE_URL_PUBLICA>/correo/oauth/callback
# y las APIs Gmail y Google Calendar habilitadas. Con esto cada buzón de Gmail
# se conecta con "Conectar con Google" (IMAP por XOAUTH2 + calendario
# completo) sin contraseña de aplicación. También se captura desde Correo.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Inteligencia artificial (OpenRouter) ---
# Una llave para todo lo que el portal resuelva con un modelo. Primer uso: lo
# que las reglas de correo no reconocen (ni recibo ni aviso de un proveedor
# conocido) se manda al modelo, que decide si es un pendiente, de qué empresa,
# con qué prioridad y para cuándo; cada correo se analiza una sola vez
# (datos/ia-correo.json). También se captura desde Equipo → Configuración.
OPENROUTER_API_KEY=
# Por omisión anthropic/claude-haiku-4.5; anthropic/claude-sonnet-5 afina más.
OPENROUTER_MODEL=
# Días de correo que se analizan y tope de correos nuevos por lectura.
OPENROUTER_DIAS=7
OPENROUTER_MAXIMO=40

# --- Buzones de correo: juntas, pendientes y licencias ---
#
# De cada buzón el puente saca las invitaciones con archivo de calendario
# (juntas), los correos que piden una acción (pendientes) y los recibos de
# suscripciones (licencias). Entra por IMAP, solo lectura, y nunca marca nada
# como leído.
#
# Formato: id|proveedor|host|puerto|usuario|buzones ; separados por punto y coma.
#   id         el de la cuenta en portal-defaults.ts; la ruta es /correo/<id>
#   proveedor  google | imap | microsoft
#   buzones    carpetas IMAP a leer, separadas por coma (por omisión INBOX)
#
# La contraseña de cada buzón va en su propia variable CORREO_CONTRASENA_<ID>
# (el id en mayúsculas y con los guiones como guion bajo), para que un `|` en
# la contraseña no rompa el formato y para capturar cada secreto por su lado
# en el panel del servidor. Un buzón sin contraseña queda apagado y Ajustes
# dice qué variable falta.
#
#   google     contraseña de aplicación: myaccount.google.com → Seguridad →
#              Verificación en dos pasos → Contraseñas de aplicaciones.
#   imap       Neubox: la contraseña del buzón. iCloud: contraseña específica
#              de aplicación en appleid.apple.com → Iniciar sesión y seguridad;
#              el usuario de iCloud es el Apple ID, no la dirección @icloud.com.
#   microsoft  Microsoft ya no acepta IMAP con contraseña (ni 365 ni
#              Outlook.com): se entra por Microsoft Graph con una aplicación
#              registrada en Entra ID (client ID y secret, permisos delegados
#              Mail.Read, Calendars.Read, User.Read, offline_access; URI de
#              redirección <PUENTE_URL_PUBLICA>/correo/oauth/callback). El
#              client ID/secret y el consentimiento se capturan desde
#              Ajustes → Correo, y quedan en CORREO_DIRECTORIO.
#
# Las ocho cuentas que hoy conoce el portal:
CORREO_CUENTAS=correo-nexus|microsoft|outlook.office365.com|993|carlos.limon@nexusqtech.com|INBOX;correo-outlook|microsoft|outlook.office365.com|993|carloslimon@outlook.com|INBOX;correo-vanguardia|microsoft|outlook.office365.com|993|webmaster@grupovanguardia.com|INBOX;correo-itech|microsoft|outlook.office365.com|993|climon@itechdev.com.mx|INBOX;correo-itech-alterno|microsoft|outlook.office365.com|993|carlos.limon@itechdev.com.mx|INBOX;correo-gmail|google|imap.gmail.com|993|limon2633@gmail.com|[Gmail]/Todos;correo-icloud|imap|imap.mail.me.com|993|limon2633@gmail.com|INBOX;correo-dealer|imap|mail.dealersolutions.com.mx|993|carlos.limon@dealersolutions.com.mx|INBOX
CORREO_CONTRASENA_CORREO_GMAIL=
CORREO_CONTRASENA_CORREO_ICLOUD=
CORREO_CONTRASENA_CORREO_DEALER=
# Cuántos días hacia atrás se leen los encabezados. Un año alcanza para ver
# las renovaciones anuales; las juntas solo se buscan en los últimos 60 días.
CORREO_DIAS_ATRAS=400
# Leer un buzón por IMAP tarda segundos: se guarda en caché este tiempo.
CACHE_CORREO_SEGUNDOS=900

# --- Ingesta: quién puede mandarnos datos ---
#
# La otra manera de traer datos: en vez de ir por ellos, los recibimos.
# Ver INGESTA.md para los cuerpos de cada envío.
#
# Formato: nombre|token|tipos|cuenta|vigenciaSegundos ; separados por punto y coma.
#   nombre    identifica al emisor y aparece en su ruta de lectura
#   token     lo que manda en Authorization: Bearer. Genera uno largo y al azar
#   tipos     pendientes,juntas,monitoreo,crm,licencias,despliegues,repos
#   cuenta    con qué cuenta del portal se marcan sus datos
#   vigencia  cada cuántos segundos se espera un envío; 0 = nunca vence
#
# Ejemplo:
#   ops|<token>|pendientes|ops|900;vigia|<token>|monitoreo|plataformas|300
INGESTA_CLIENTES=

# Dónde se guarda lo recibido, para que un reinicio no lo pierda.
INGESTA_DIRECTORIO=datos/ingesta
# Tope del cuerpo de un envío, en kilobytes.
INGESTA_MAXIMO_KB=512
