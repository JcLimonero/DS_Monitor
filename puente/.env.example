# Configuración del puente.
#
# Copiar a .env (que está en .gitignore) o cargar estas variables en el panel
# del servidor. AQUÍ VAN LAS CREDENCIALES: este archivo de ejemplo no lleva
# ninguna de verdad, y el .env real nunca se sube al repositorio.
#
# Nada es obligatorio. Una conexión sin credencial queda apagada, su ruta
# responde 503 diciendo qué falta, y el resto del puente sigue funcionando: así
# se puede conectar una fuente a la vez.

# --- Servidor ---
PUENTE_PUERTO=8787
# Prefijo bajo el que cuelga, si va detrás de un proxy. En producción el portal
# lo espera en /api/portal.
PUENTE_PREFIJO=
# Orígenes que pueden llamarlo, separados por coma. Vacío = solo mismo origen,
# que es lo recomendable: así la cookie de sesión viaja sola y no hace falta CORS.
PUENTE_ORIGENES=

# --- Cuánto vive cada respuesta en caché, en segundos ---
# Los datos de uso de Claude tardan hasta cinco minutos en aparecer y no
# conviene sondear más de una vez por minuto, así que cinco minutos es el piso
# razonable para licencias.
CACHE_LICENCIAS_SEGUNDOS=300
CACHE_DESPLIEGUES_SEGUNDOS=30
CACHE_ESTADO_SEGUNDOS=60
CACHE_MONITOREO_SEGUNDOS=60
CACHE_CRM_SEGUNDOS=120

# --- Claude (Anthropic) ---
# Admin API key de la organización, no una llave normal de API.
# Se crea en la consola: Settings -> Admin keys.
ANTHROPIC_ADMIN_KEY=
ANTHROPIC_ACCOUNT_ID=claude
# Los asientos de Claude Code no salen de la API de uso. Si se capturan aquí,
# el portal los muestra marcados como capturados a mano.
ANTHROPIC_ASIENTOS=
ANTHROPIC_COSTO_ASIENTOS=
ANTHROPIC_RENUEVA_EN=

# --- Cursor ---
# Team API key con permiso admin:* o usage:*.
CURSOR_API_KEY=
CURSOR_ACCOUNT_ID=cursor
CURSOR_ASIENTOS=
CURSOR_COSTO_MENSUAL=
CURSOR_SOLICITUDES_INCLUIDAS=
CURSOR_RENUEVA_EN=

# --- Figma ---
# OJO: Figma no publica facturación ni asientos contratados por API. Con el
# token se cuentan los asientos ocupados; el tope, el costo y la renovación se
# capturan abajo y la licencia sale marcada como capturada a mano.
FIGMA_TOKEN=
FIGMA_TEAM_ID=
FIGMA_ACCOUNT_ID=figma
FIGMA_ASIENTOS=
FIGMA_COSTO_MENSUAL=
FIGMA_RENUEVA_EN=

# --- Vercel ---
VERCEL_TOKEN=
VERCEL_ACCOUNT_ID=vercel
# Sale de la configuración general del equipo en el panel de Vercel.
VERCEL_TEAM_ID=
VERCEL_LIMITE=20
VERCEL_URL_ESTADO=https://www.vercel-status.com/api/v2/status.json
# El gasto del periodo no viene por API; si se captura aquí, sale como licencia.
VERCEL_PRESUPUESTO=
VERCEL_GASTO=
VERCEL_RENUEVA_EN=

# --- Monitoreo de sitios y servicios ---
# Formato: id|nombre|url|tipo|entorno ; separados por punto y coma.
# tipo: sitio | api | servicio | proceso
# entorno: produccion | pruebas | desarrollo
MONITOREO_ACCOUNT_ID=plataformas
MONITOREO_DESTINOS=

# --- Odoo (CRM de Itech) ---
ODOO_URL=
ODOO_DB=
ODOO_USUARIO=
# Clave de API del usuario, no su contraseña.
ODOO_API_KEY=
ODOO_ACCOUNT_ID=itech
