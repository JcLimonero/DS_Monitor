{
  "name": "portal-pendientes",
  "version": "0.1.0",
  "description": "Portal personal: pendientes, juntas, monitoreo de plataformas y CRM de Odoo en una sola vista",
  "private": true,
  "scripts": {
    "start": "ng serve",
    "build": "ng build --configuration production",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "format": "prettier --write \"src/**/*.{ts,html,scss,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,scss,json}\""
  },
  "dependencies": {
    "@angular/common": "^20.3.27",
    "@angular/compiler": "^20.3.27",
    "@angular/core": "^20.3.27",
    "@angular/forms": "^20.3.27",
    "@angular/platform-browser": "^20.3.27",
    "@angular/router": "^20.3.27",
    "rxjs": "^7.8.1",
    "tslib": "^2.6.2"
  },
  "devDependencies": {
    "@angular/build": "^20.3.33",
    "@angular/cli": "^20.3.33",
    "@angular/compiler-cli": "^20.3.27",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.26",
    "prettier": "^3.2.2",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.9.3"
  }
}
